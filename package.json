{
  "name": "octopi",
  "version": "0.3.2",
  "description": "可嵌入的 Agent 引擎",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "octopi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-sdk/plugin-entry": {
      "types": "./dist/plugins/entry.d.ts",
      "import": "./dist/plugins/entry.js"
    },
    "./plugin-sdk/api": {
      "types": "./dist/plugins/api.d.ts",
      "import": "./dist/plugins/api.js"
    },
    "./plugin-sdk/manifest": {
      "types": "./dist/plugins/manifest.d.ts",
      "import": "./dist/plugins/manifest.js"
    },
    "./plugin-sdk/capability": {
      "types": "./dist/plugins/capability.d.ts",
      "import": "./dist/plugins/capability.js"
    },
    "./plugin-sdk/loader": {
      "types": "./dist/plugins/loader.d.ts",
      "import": "./dist/plugins/loader.js"
    },
    "./plugin-sdk/manager": {
      "types": "./dist/plugins/manager.d.ts",
      "import": "./dist/plugins/manager.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.0",
    "@types/ws": "^8.18.1",
    "chalk": "^5.6.2",
    "ws": "^8.21.0"
  }
}