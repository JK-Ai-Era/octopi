{
  "name": "octopi-agent",
  "version": "0.59.0",
  "description": "Octopi suite — CLI (bin: octopi), config IO, and dependency umbrella for core/engine/gateway/webui",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "octopi": "./dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build:core && npm run build:engine && npm run build:gateway && npm run build:web && tsc && node scripts/copy-build-assets.mjs && node scripts/generate-octopi-schema.mjs",
    "build:core": "npm --prefix packages/core run build",
    "build:engine": "npm --prefix packages/engine run build",
    "build:gateway": "npm --prefix packages/gateway run build",
    "copy:build-assets": "node scripts/copy-build-assets.mjs",
    "generate:schema": "node scripts/generate-octopi-schema.mjs",
    "release:prep": "node scripts/release.mjs prep",
    "release:print": "node scripts/release.mjs print",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "lint": "eslint .",
    "test:coverage": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run --coverage",
    "install:all": "npm install && npm --prefix packages/webui install",
    "build:web": "npm --prefix packages/webui run build",
    "serve": "node dist/cli/index.js serve fg",
    "web": "npm --prefix packages/webui run dev"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "octopi.schema.json",
    "octopi.example.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README_CN.md"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octopi-agent/core": "0.59.0",
    "@octopi-agent/engine": "0.59.0",
    "@octopi-agent/gateway": "0.59.0",
    "@octopi-agent/webui": "0.59.0",
    "@types/ws": "^8.18.1",
    "chalk": "^5.6.2",
    "js-yaml": "^4.3.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JK-Ai-Era/octopi.git"
  },
  "homepage": "https://github.com/JK-Ai-Era/octopi#readme",
  "bugs": {
    "url": "https://github.com/JK-Ai-Era/octopi/issues"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "octopi",
    "harness"
  ]
}
