{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Octopi Configuration",
  "description": "Octopi Agent Framework 配置文件 (v0.3.0)",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "description": "Agent 定义列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Agent 唯一标识"
          },
          "home": {
            "type": "string",
            "description": "Agent home 目录：persona、memory、wisdom、skills、sessions 的根目录"
          },
          "workspace": {
            "type": "string",
            "description": "沙箱工作目录：agent 工具操作的 cwd"
          },
          "persona": {
            "description": "Persona 配置（向后兼容：string 形式等价于 home）",
            "oneOf": [
              {
                "type": "string",
                "description": "Persona 目录路径（已废弃，请使用 home）"
              },
              {
                "type": "object",
                "required": ["systemPrompt"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "systemPrompt": { "type": "string" }
                }
              }
            ]
          },
          "model": {
            "type": "object",
            "required": ["provider", "model"],
            "properties": {
              "provider": {
                "type": "string",
                "description": "Provider 名称（引用 providers[].name）"
              },
              "model": {
                "type": "string",
                "description": "模型名称"
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              },
              "fallbackModels": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "tools": {
            "type": "object",
            "properties": {
              "allow": {
                "type": "array",
                "items": { "type": "string" }
              },
              "deny": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requireConfirmation": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "skillDirectory": {
            "type": "string",
            "description": "Skill 目录路径"
          },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "channelBindings": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "集中模型配置",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["merge", "replace"],
          "description": "合并模式：merge=与 builtin 合并，replace=完全替代"
        },
        "providers": {
          "type": "object",
          "description": "Provider 映射（key = provider 名称）",
          "additionalProperties": {
            "type": "object",
            "required": ["baseUrl", "apiKey", "api", "models"],
            "properties": {
              "baseUrl": { "type": "string", "description": "API Base URL" },
              "apiKey": { "type": "string", "description": "API Key（支持 ${ENV_VAR} 语法）" },
              "api": {
                "type": "string",
                "enum": ["openai-completions", "anthropic-messages"],
                "description": "API 协议类型"
              },
              "models": {
                "type": "array",
                "description": "模型列表",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "description": "模型 ID" },
                    "name": { "type": "string", "description": "模型名称（默认等于 id）" },
                    "contextWindow": { "type": "integer", "description": "上下文窗口大小" },
                    "maxTokens": { "type": "integer", "description": "最大输出 token 数" },
                    "reasoning": { "type": "boolean", "description": "是否支持推理模式" }
                  }
                }
              },
              "timeoutSeconds": { "type": "number", "description": "请求超时（秒）" }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "description": "Plugin 配置",
      "properties": {
        "loadPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Plugin 目录扫描路径"
        },
        "configs": {
          "type": "object",
          "description": "单个 plugin 的配置（plugin id → config）",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "supervisor": {
      "type": "object",
      "description": "任务监督器配置（智能监督，替代硬预算限制）",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用智能监督"
        },
        "checkpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 15,
          "description": "基础检查间隔（迭代数）"
        },
        "minCheckpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "最小检查间隔"
        },
        "maxCheckpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 50,
          "description": "最大检查间隔"
        },
        "enableLLMReview": {
          "type": "boolean",
          "default": true,
          "description": "启用 LLM 审查（规则层不确定时用轻量模型判断）"
        },
        "llmReviewInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "LLM 审查频率（每 N 个检查点审查一次）"
        },
        "llmModel": {
          "type": "string",
          "description": "审查用模型。格式: \"model\"（用主 provider）或 \"provider/model\"（指定 provider）"
        },
        "hardLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "硬上限：最大迭代数（安全兜底）"
        },
        "hardWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 36000000,
          "description": "硬上限：最大运行时间（毫秒，默认 10 小时）"
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "迭代预算（安全兜底，由 supervisor 接管主要控制）",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "最大迭代次数（建议设为宽松值，如 1000）"
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "description": "最大工具调用次数"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "description": "最大 token 数"
        },
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "description": "最大运行时间（毫秒）"
        }
      }
    },
    "security": {
      "type": "object",
      "description": "安全策略配置",
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["development", "testing", "production", "maximum"],
          "description": "安全预设"
        },
        "injectionSensitivity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "注入检测灵敏度"
        }
      }
    },
    "channels": {
      "type": "array",
      "description": "Channel 适配器列表",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Channel 类型"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string"
          },
          "apiKey": {
            "type": "string",
            "description": "API Key（HTTP channel 认证）"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "description": "Session 配置（路由策略 + 存储引擎）",
      "properties": {
        "dmScope": {
          "type": "string",
          "enum": ["main", "per-peer", "per-channel-peer"],
          "description": "DM 作用域"
        },
        "store": {
          "type": "object",
          "description": "Session 存储配置",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["memory", "jsonl", "sqlite"],
              "description": "存储类型"
            },
            "dataDir": {
              "type": "string",
              "description": "数据目录（jsonl 类型使用）"
            },
            "dbPath": {
              "type": "string",
              "description": "数据库文件路径（sqlite 类型使用）"
            }
          }
        }
      }
    }
  }
}
