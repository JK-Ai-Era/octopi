{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Octopi Configuration",
  "description": "Octopi Agent Framework 配置文件 (v0.3.0)",
  "type": "object",
  "required": [
    "agents"
  ],
  "properties": {
    "agents": {
      "type": "array",
      "description": "Agent 定义列表",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "model"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Agent 唯一标识"
          },
          "home": {
            "type": "string",
            "description": "Agent home 目录：persona、skills、sessions、extract 的根目录（memory/wisdom 走 AgentDatabase SQLite）"
          },
          "workspace": {
            "type": "string",
            "description": "沙箱工作目录：agent 工具操作的 cwd"
          },
          "persona": {
            "description": "Persona 配置（向后兼容：string 形式等价于 home）",
            "oneOf": [
              {
                "type": "string",
                "description": "Persona 目录路径（已废弃，请使用 home）"
              },
              {
                "type": "object",
                "required": [
                  "systemPrompt"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "systemPrompt": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "model": {
            "type": "object",
            "required": [
              "provider",
              "model"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "description": "Provider 名称（引用 providers[].name）"
              },
              "model": {
                "type": "string",
                "description": "模型名称"
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              },
              "fallbackModels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "tools": {
            "type": "object",
            "properties": {
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requireConfirmation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "skillDirectory": {
            "type": "string",
            "description": "Skill 目录路径"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channelBindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "集中模型配置",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "merge",
            "replace"
          ],
          "description": "合并模式：merge=与 builtin 合并，replace=完全替代"
        },
        "providers": {
          "type": "object",
          "description": "Provider 映射（key = provider 名称）",
          "additionalProperties": {
            "type": "object",
            "required": [
              "baseUrl",
              "apiKey",
              "api",
              "models"
            ],
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "API Base URL"
              },
              "apiKey": {
                "type": "string",
                "description": "API Key（支持 ${ENV_VAR} 语法）"
              },
              "api": {
                "type": "string",
                "enum": [
                  "openai-completions",
                  "anthropic-messages"
                ],
                "description": "API 协议类型"
              },
              "models": {
                "type": "array",
                "description": "模型列表",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "模型 ID"
                    },
                    "name": {
                      "type": "string",
                      "description": "模型名称（默认等于 id）"
                    },
                    "contextWindow": {
                      "type": "integer",
                      "description": "上下文窗口大小"
                    },
                    "maxTokens": {
                      "type": "integer",
                      "description": "最大输出 token 数"
                    },
                    "reasoning": {
                      "type": "boolean",
                      "description": "是否支持推理模式"
                    }
                  }
                }
              },
              "timeoutSeconds": {
                "type": "number",
                "description": "请求超时（秒）"
              }
            }
          }
        },
        "level": {
          "type": "object",
          "description": "模型级别映射（子系统通过级别名引用具体模型）",
          "additionalProperties": {
            "type": "object",
            "required": [
              "primary"
            ],
            "properties": {
              "primary": {
                "type": "string",
                "description": "主模型，格式: provider/model"
              },
              "fallback": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "降级模型列表（按优先级排列，格式: provider/model）"
              }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "description": "Plugin 配置",
      "properties": {
        "loadPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plugin 目录扫描路径"
        },
        "configs": {
          "type": "object",
          "description": "单个 plugin 的配置（plugin id → config）",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "contextEngine": {
      "type": "object",
      "description": "上下文引擎配置（消息窗口压缩 + 主动摘要）",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["default", "custom"],
          "default": "default"
        },
        "protectFirstN": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "头部保护消息数"
        },
        "protectLastN": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "尾部保护消息数"
        },
        "compactThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "触发存储压缩的阈值比例"
        },
        "proactiveCompactRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6,
          "description": "主动摘要阈值：消息 token / messagesBudget 超过该比例时，在硬溢出前 LLM 摘要（0=关闭）"
        },
        "proactiveCooldownMs": {
          "type": "number",
          "minimum": 0,
          "default": 30000,
          "description": "主动 LLM 摘要冷却毫秒；冷却期内优先缓存重建（0=不冷却）"
        },
        "outputRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2,
          "description": "输出预留比例"
        },
        "minOutputReserve": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2000
        },
        "maxOutputReserve": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 8000
        },
        "enableLLMSummary": {
          "type": "boolean",
          "default": true
        },
        "summaryModel": {
          "type": "string",
          "description": "摘要模型（可选）"
        }
      },
      "additionalProperties": false
    },
    "contextAssembler": {
      "type": "object",
      "description": "system prompt 七层装配器配置（层预算与可观测 preview）",
      "properties": {
        "systemBudgetRatio": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.22,
          "description": "system 预算占 contextWindow 比例"
        },
        "layerShares": {
          "type": "object",
          "description": "单层硬顶：层 id → contentBudget 比例 [0,1]。默认不配置=无单层配额；仅配置的层超出时先截断到硬顶。",
          "additionalProperties": false,
          "properties": {
            "wisdom": { "type": "number", "minimum": 0, "maximum": 1 },
            "persona": { "type": "number", "minimum": 0, "maximum": 1 },
            "skill": { "type": "number", "minimum": 0, "maximum": 1 },
            "knowledge": { "type": "number", "minimum": 0, "maximum": 1 },
            "cognition": { "type": "number", "minimum": 0, "maximum": 1 },
            "memory": { "type": "number", "minimum": 0, "maximum": 1 },
            "runtime": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "includeLayerPreview": {
          "type": "boolean",
          "default": true,
          "description": "是否在 AssembleManifest 写入层正文 preview（供 Web 上下文面板）"
        },
        "layerPreviewChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000,
          "default": 400,
          "description": "层 preview 最大字符数"
        },
        "includeLayerContent": {
          "type": "boolean",
          "default": true,
          "description": "是否在 AssembleManifest 写入层正文全文（点选层查看内容）"
        }
      },
      "additionalProperties": false
    },
    "constitution": {
      "type": "object",
      "description": "全局运行宪法（等价 context.constitution）。product=包内资产；custom=集成商全文；off=不装配 preamble",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["product", "custom", "off"],
          "default": "product"
        },
        "path": {
          "type": ["string", "null"],
          "description": "mode=custom 时必填的宪法文件路径"
        }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "description": "context 域扩展配置",
      "properties": {
        "constitution": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["product", "custom", "off"] },
            "path": { "type": ["string", "null"] }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        "contextAssembler": { "$ref": "#/properties/contextAssembler" }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "description": "Memory 写入与置信度策略",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["personal_assistant", "embedded_interactive", "embedded_headless"]
        },
        "confidence": {
          "type": "object",
          "properties": {
            "injectMinScore": { "type": "number", "minimum": 0, "maximum": 1 },
            "channelPriors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "user_directive": { "type": "number", "minimum": 0, "maximum": 1 },
                "decision": { "type": "number", "minimum": 0, "maximum": 1 },
                "fail_fix": { "type": "number", "minimum": 0, "maximum": 1 },
                "model_inference": { "type": "number", "minimum": 0, "maximum": 1 },
                "admin": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runGuard": {
      "type": "object",
      "description": "过程监督配置（智能监督，替代硬预算限制）",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用过程监督"
        },
        "checkpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 15,
          "description": "基础检查间隔（迭代数）"
        },
        "minCheckpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "最小检查间隔"
        },
        "maxCheckpointInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 50,
          "description": "最大检查间隔"
        },
        "enableLLMReview": {
          "type": "boolean",
          "default": true,
          "description": "启用 LLM 审查（规则层不确定时用轻量模型判断）"
        },
        "llmReviewInterval": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "LLM 审查频率（每 N 个检查点审查一次）"
        },
        "llmModel": {
          "type": "string",
          "description": "审查用模型。格式: \"model\"（用主 provider）或 \"provider/model\"（指定 provider）"
        },
        "hardLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "硬上限：最大迭代数（安全兜底）"
        },
        "hardWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 36000000,
          "description": "硬上限：最大运行时间（毫秒，默认 10 小时）"
        }
      }
    },
    "agentRuntime": {
      "type": "object",
      "description": "激活宿主（long-lived）。消息路径始终经 Runtime；Schedule/Escalate 按配置块挂载（不写则不挂，无 enabled 总开关）。设计见 arch/agent-runtime.md",
      "properties": {
        "coalesceWindowMs": {
          "type": "integer",
          "minimum": 0,
          "default": 400,
          "description": "合批窗口（毫秒）"
        },
        "coalesceBufferLimit": {
          "type": "integer",
          "minimum": 1,
          "default": 256,
          "description": "合批缓冲条目上限"
        },
        "expectedMaxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "description": "期望最大并发 Run（仅观测；硬闸归 SessionGate）"
        },
        "schedule": {
          "type": "array",
          "description": "定时触发任务（每条绑定 agentId）",
          "items": {
            "type": "object",
            "required": ["agentId", "content"],
            "properties": {
              "agentId": { "type": "string" },
              "sessionId": { "type": "string" },
              "intervalMs": { "type": "integer", "minimum": 1 },
              "cron": {
                "type": "string",
                "description": "简化 cron（分 时 日 月 周）；与 intervalMs 二选一"
              },
              "content": { "type": "string", "description": "注入内容（system note）" },
              "coalesceKey": { "type": "string" },
              "runOnStart": { "type": "boolean", "default": false }
            }
          }
        },
        "escalate": {
          "type": "object",
          "description": "子系统 escalate → 唤醒主 Agent。需与 Subsystem 同一 EventBus（Gateway 已接 gatewayBus）",
          "properties": {
            "defaultAgentId": { "type": "string" },
            "eventType": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ],
              "description": "默认同时订阅 subsystem.signal.escalate 与 subsystem.escalate"
            }
          }
        },
        "agentSignal": {
          "type": "boolean",
          "description": "订阅 runtime.agent_signal；默认在 escalate.defaultAgentId 存在时挂载，或显式 true"
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "资源 soft/hard 总闸（与 runGuard 组合：budget 管资源，runGuard 管行为）。主轴 token + wall-clock；maxIterations 仅显式配置时硬停。",
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 2000000,
          "description": "硬顶：最大 token 数"
        },
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 21600000,
          "description": "硬顶：最大运行时间（毫秒，默认 6 小时）"
        },
        "softTokens": {
          "type": "integer",
          "minimum": 1,
          "description": "soft：token 触达（默认约 hard 的 20%）；有进展可静默续租"
        },
        "softWallClockMs": {
          "type": "integer",
          "minimum": 1000,
          "description": "soft：时间触达（默认约 hard 的 35%）"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "最大迭代次数。仅显式设置时硬停；默认不设（长任务不靠 iteration 卡死）"
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "description": "最大工具调用次数。仅显式设置时硬停"
        },
        "autoRenewOnProgress": {
          "type": "boolean",
          "default": true,
          "description": "soft 触达且有进展时自动续租"
        },
        "maxRenews": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "最大续租次数"
        }
      }
    },
    "security": {
      "type": "object",
      "description": "安全策略配置",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "development",
            "testing",
            "production",
            "maximum"
          ],
          "description": "安全预设"
        },
        "injectionSensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "注入检测灵敏度"
        }
      }
    },
    "channels": {
      "type": "array",
      "description": "Channel 适配器列表",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Channel 类型"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string"
          },
          "apiKey": {
            "type": "string",
            "description": "API Key（HTTP channel 认证）"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "description": "Session 配置（路由策略 + 存储引擎）",
      "properties": {
        "dmScope": {
          "type": "string",
          "enum": [
            "main",
            "per-peer",
            "per-channel-peer"
          ],
          "description": "DM 作用域"
        },
        "store": {
          "type": "object",
          "description": "Session 存储配置",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "memory",
                "jsonl",
                "sqlite"
              ],
              "description": "存储类型"
            },
            "dataDir": {
              "type": "string",
              "description": "数据目录（jsonl 类型使用）"
            },
            "dbPath": {
              "type": "string",
              "description": "数据库文件路径（sqlite 类型使用）"
            }
          }
        }
      }
    },
    "subsystems": {
      "type": "object",
      "description": "自主子系统框架级配置（子系统自身参数写在各自 config.yaml）",
      "properties": {
        "auditDir": {
          "type": "string",
          "description": "审计日志目录（默认 ~/.octopi/audit）"
        },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允许注册：id / packageId / memory.steward.* 前缀"
        },
        "denylist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "禁止注册（优先于 allowlist）"
        }
      }
    },
    "web": {
      "type": "object",
      "description": "Web UI 运行配置",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1,
          "description": "Web UI 源码目录（含 package.json 的 Vite 项目）。未设置时 CLI 按 OCTOPI_WEB_DIR → 配置旁 web/ → ~/.octopi/web → CLI 包内 web/ → cwd/web 探测"
        }
      }
    },
    "webSearch": {
      "type": "object",
      "description": "web_search 工具多 provider 配置",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "主 provider key（对应 providers 的 key）；未指定时取 providers 第一个"
        },
        "fallbacks": {
          "type": "array",
          "description": "失败降级链（provider key 列表）",
          "items": { "type": "string", "minLength": 1 }
        },
        "defaultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5,
          "description": "默认返回条数"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 15000,
          "description": "全局超时（毫秒）"
        },
        "providers": {
          "type": "object",
          "description": "provider 映射",
          "additionalProperties": {
            "type": "object",
            "required": ["api"],
            "properties": {
              "api": {
                "type": "string",
                "enum": ["duckduckgo", "tavily", "brave", "serper", "mimo"],
                "description": "实现类型"
              },
              "apiKey": {
                "type": "string",
                "description": "API Key（支持 ${ENV_VAR}；duckduckgo 可省略）"
              },
              "baseUrl": {
                "type": "string",
                "description": "覆盖默认 baseUrl"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "description": "覆盖默认超时（毫秒）"
              },
              "model": {
                "type": "string",
                "description": "MiMo 专用：模型 ID（默认 mimo-v2.5-pro）"
              },
              "maxKeyword": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "description": "MiMo 专用：搜索关键词数上限（max_keyword，默认 3）"
              },
              "forceSearch": {
                "type": "boolean",
                "description": "MiMo 专用：是否强制搜索（force_search，默认 true）"
              },
              "userLocation": {
                "type": "object",
                "description": "MiMo 专用：用户位置（approximate）",
                "properties": {
