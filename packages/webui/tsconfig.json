{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@octopi-agent/gateway/web/sdk/client": ["../../packages/gateway/src/web/sdk/client.ts"],
      "@octopi-agent/gateway/web/runtime/store": ["../../packages/gateway/src/web/runtime/store.ts"],
      "@octopi-agent/gateway/web/conversation/types": ["../../packages/gateway/src/web/conversation/types.ts"],
      "@octopi-agent/gateway/*": ["../../packages/gateway/src/*"],
      "@octopi-agent/engine/*": ["../../packages/engine/src/*"],
      "@octopi-agent/core/*": ["../../packages/core/src/core/*"]
    }
  },
  "include": ["src"]
}
