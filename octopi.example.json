{
  "$schema": "./octopi.schema.json",

  "models": {
    "mode": "merge",
    "level": {
      "summary": { "primary": "openai/gpt-5-mini" },
      "mini": { "primary": "openai/gpt-5-mini" },
      "standard": { "primary": "openai/gpt-5.5" }
    },
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "gpt-5.5", "name": "gpt-5.5", "contextWindow": 256000, "maxTokens": 32768 },
          { "id": "gpt-5-mini", "name": "gpt-5-mini", "contextWindow": 128000, "maxTokens": 16384 }
        ]
      },
      "anthropic": {
        "baseUrl": "https://api.anthropic.com",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          { "id": "claude-sonnet-4-6", "name": "claude-sonnet-4-6", "contextWindow": 200000, "maxTokens": 16000 },
          { "id": "claude-opus-4-6", "name": "claude-opus-4-6", "contextWindow": 200000, "maxTokens": 32000 }
        ]
      }
    },
    "embedding": {
      "enabled": true,
      "type": "openai",
      "provider": "openai",
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "vectorEngine": "auto"
    }
  },

  "agents": [{
    "id": "assistant",
    "home": "./agents/assistant",
    "workspace": "./workspace/assistant",
    "skillDirectory": "./agents/assistant/skills",
    "model": "openai/gpt-5.5",
    "tools": { "allow": ["*"] }
  }],

  "security": {
    "enforce": "block",
    "injectionSensitivity": "medium",
    "allowedPaths": []
  },

  "budgetPolicy": {
    "maxWallClockMs": 21600000
  },

  "contextEngine": {
    "proactiveCompactRatio": 0.6,
    "proactiveCooldownMs": 30000,
    "protectLastN": 20
  },

  "summary": {
    "modelLevel": "summary",
    "defaultInputBudgetTokens": 24000,
    "safetyMarginTokens": 2000,
    "oversizedStrategy": "map_reduce",
    "gate": {
      "minTokens": 2000,
      "minBytes": 8000
    },
    "tools": {
      "maxReturnChars": 8000
    }
  },

  "contextAssembler": {
    "systemBudgetRatio": 0.22,
    "includeLayerPreview": true,
    "layerPreviewChars": 400,
    "includeLayerContent": true
  },

  "context": {
    "constitution": {
      "mode": "product",
      "path": null
    }
  },

  "memory": {
    "profile": "embedded_interactive",
    "backfill": {
      "enabled": true,
      "idleDelayMs": 1200000,
      "gapScanMs": 21600000,
      "minUserTurns": 2
    },
    "decay": {
      "typeParams": {
        "method": { "idleDays": 21, "factor": 0.93, "min": 0.1 }
      }
    },
    "health": {
      "intervalMs": 3600000,
      "shadowBacklogLimit": 50,
      "limits": { "fact": 200, "method": 100, "norm": 150 }
    },
    "confidence": {
      "injectMinScore": 0.55
    }
  },

  "knowledge": {
    "recall": "hybrid",
    "autoInject": {
      "minScore": 0.78,
      "maxChunks": 4,
      "budgetTokens": 1200,
      "minCoverage": 0.5
    },
    "hint": { "minScore": 0.55 },
    "keywordWeight": 0.45,
    "catalog": {
      "maxEntries": 10,
      "autoDescribe": true
    },
    "query": {
      "includePriorUserTurns": 1,
      "skipIfUserTokensBelow": 8
    },
    "promotion": {
      "metrics": { "minSessions": 3, "minHits": 10 }
    }
  },

  "runGuard": {
    "enabled": true,
    "checkpointInterval": 15
  },

  "agentRuntime": {
    "coalesceWindowMs": 400
  },

  "channels": [{
    "type": "http",
    "port": 3000,
    "host": "local",
    "path": "/messages"
  }],

  "session": {
    "dmScope": "per-peer"
  },

  "toolIsolation": "session-subdir",

  "sessionAcl": {
    "switchDefaults": {
      "preferredOnly": true,
      "consultGrantRole": "specialist",
      "requireExplicitHandoff": true
    },
    "allowAgentInitiatedHandoff": false
  },

  "observer": {
    "level": "off",
    "webPanel": false,
    "failOpen": true
  },

  "webSearch": {
    "provider": "duckduckgo",
    "fallbacks": [],
    "defaultLimit": 5,
    "timeoutMs": 15000,
    "providers": {
      "duckduckgo": { "api": "duckduckgo" },
      "tavily": { "api": "tavily", "apiKey": "${TAVILY_API_KEY}" },
      "brave": { "api": "brave", "apiKey": "${BRAVE_API_KEY}" },
      "serper": { "api": "serper", "apiKey": "${SERPER_API_KEY}" },
      "mimo": {
        "api": "mimo",
        "apiKey": "${MIMO_API_KEY}",
        "model": "mimo-v2.5-pro",
        "maxKeyword": 3,
        "forceSearch": true,
        "timeoutMs": 90000,
        "userLocation": { "country": "China" }
      }
    }
  },

  "web": {
    "dir": "./web",
    "host": "local"
  }
}
