{
  "$schema": "./octopi.schema.json",

  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "gpt-5.5", "name": "gpt-5.5", "contextWindow": 256000, "maxTokens": 32768 },
          { "id": "gpt-5-mini", "name": "gpt-5-mini", "contextWindow": 128000, "maxTokens": 16384 }
        ]
      },
      "anthropic": {
        "baseUrl": "https://api.anthropic.com",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          { "id": "claude-sonnet-4-6", "name": "claude-sonnet-4-6", "contextWindow": 200000, "maxTokens": 16000 },
          { "id": "claude-opus-4-6", "name": "claude-opus-4-6", "contextWindow": 200000, "maxTokens": 32000 }
        ]
      }
    },
    "embedding": {
      "enabled": true,
      "type": "openai",
      "provider": "openai",
      "model": "text-embedding-3-small",
      "dimensions": 1536,
      "vectorEngine": "auto"
    }
  },

  "agents": [{
    "id": "assistant",
    "home": "./agents/assistant",
    "workspace": "./workspace/assistant",
    "skillDirectory": "./agents/assistant/skills",
    "model": "openai/gpt-5.5",
    "tools": { "allow": ["*"] }
  }],

  "security": {
    "preset": "production"
  },

  "budget": {
    "maxTokens": 2000000,
    "maxWallClockMs": 21600000,
    "softTokens": 400000,
    "softWallClockMs": 2400000
  },

  "contextEngine": {
    "proactiveCompactRatio": 0.6,
    "proactiveCooldownMs": 30000,
    "protectLastN": 20
  },

  "contextAssembler": {
    "systemBudgetRatio": 0.22,
    "includeLayerPreview": true,
    "layerPreviewChars": 400,
    "includeLayerContent": true
  },

  "context": {
    "constitution": {
      "mode": "product",
      "path": null
    }
  },

  "memory": {
    "profile": "embedded_interactive",
    "confidence": {
      "injectMinScore": 0.55
    }
  },

  "runGuard": {
    "enabled": true,
    "checkpointInterval": 15
  },

  "agentRuntime": {
    "coalesceWindowMs": 400
  },

  "channels": [{
    "type": "http",
    "port": 3000,
    "path": "/messages"
  }],

  "session": {
    "dmScope": "per-peer",
    "store": {
      "type": "jsonl",
      "dataDir": "./data/sessions"
    }
  },

  "webSearch": {
    "provider": "duckduckgo",
    "fallbacks": [],
    "defaultLimit": 5,
    "timeoutMs": 15000,
    "providers": {
      "duckduckgo": { "api": "duckduckgo" },
      "tavily": { "api": "tavily", "apiKey": "${TAVILY_API_KEY}" },
      "brave": { "api": "brave", "apiKey": "${BRAVE_API_KEY}" },
      "serper": { "api": "serper", "apiKey": "${SERPER_API_KEY}" },
      "mimo": {
        "api": "mimo",
        "apiKey": "${MIMO_API_KEY}",
        "model": "mimo-v2.5-pro",
        "maxKeyword": 3,
        "forceSearch": true,
        "timeoutMs": 90000,
        "userLocation": { "country": "China" }
      }
    }
  },

  "web": {
    "dir": "./web"
  }
}
