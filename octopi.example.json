{
  "$schema": "./octopi.schema.json",

  "agents": [{
    "id": "assistant",
    "workspace": "./workspace",
    "persona": "./personas/assistant",
    "model": {
      "provider": "openai",
      "model": "gpt-5.5"
    },
    "tools": { "allow": ["*"] }
  }],

  "providers": [
    {
      "type": "openai",
      "name": "openai",
      "apiKey": "***",
      "baseUrl": "https://api.openai.com/v1",
      "models": ["gpt-5.5", "gpt-5-mini"]
    },
    {
      "type": "anthropic",
      "name": "anthropic",
      "apiKey": "${ANTH…KEY}",
      "baseUrl": "https://api.anthropic.com",
      "models": ["claude-sonnet-4-6", "claude-opus-4-6", "claude-haiku-4-5"]
    }
  ],

  "security": {
    "preset": "production"
  },

  "store": {
    "type": "jsonl",
    "dataDir": "./data/sessions"
  },

  "channels": [{
    "type": "http",
    "port": 3000,
    "path": "/messages"
  }],

  "session": {
    "dmScope": "per-peer"
  }
}
