{
  "$schema": "./octopi.schema.json",

  "agents": [{
    "id": "assistant",
    "workspace": "./workspace",
    "persona": "./personas/assistant",
    "model": {
      "provider": "openai",
      "model": "gpt-4o"
    },
    "tools": { "allow": ["*"] }
  }],

  "providers": [
    {
      "type": "openai",
      "name": "openai",
      "apiKey": "${OPENAI_API_KEY}",
      "baseUrl": "https://api.openai.com/v1",
      "models": ["gpt-4o", "gpt-4o-mini"]
    },
    {
      "type": "anthropic",
      "name": "anthropic",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "baseUrl": "https://api.anthropic.com",
      "models": ["claude-sonnet-4-20250514", "claude-haiku-4-20250414"]
    }
  ],

  "plugins": {
    "loadPaths": ["./plugins"]
  },

  "supervisor": {
    "enabled": true,
    "checkpointInterval": 15,
    "minCheckpointInterval": 5,
    "maxCheckpointInterval": 50,
    "enableLLMReview": true,
    "llmReviewInterval": 3,
    "llmModel": "openai/gpt-4o-mini",
    "hardLimit": 1000,
    "hardWallClockMs": 36000000
  },

  "budget": {
    "maxIterations": 1000,
    "maxToolCalls": 5000,
    "maxTokens": 1000000,
    "maxWallClockMs": 36000000
  },

  "security": {
    "preset": "production"
  },

  "store": {
    "type": "jsonl",
    "dataDir": "./data/sessions"
  },

  "channels": [{
    "type": "http",
    "port": 3000,
    "path": "/messages"
  }],

  "session": {
    "dmScope": "per-peer"
  }
}
